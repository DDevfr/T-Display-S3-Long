[Unit]
Description=NUC Monitor — envoi métriques vers T-Display-S3-Long
Documentation=https://github.com/DDevfr/T-Display-S3-Long
After=network.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PROJECT_DIR@/tools
ExecStart=/usr/bin/python3 @PROJECT_DIR@/tools/monitor_sender.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
